# 复制为 .env.local 后按需填写
#
# 排盘、古籍、合盘起盘都不需要任何配置——那些全在浏览器里用本仓库的引擎跑。
# 下面这组只影响 AI 解读：/api/interpret（单盘）与 /api/heming（双盘）。

# ─── 选一个厂商：deepseek | openai | anthropic | ollama | mimo ───
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key

# ─── 任意 OpenAI 兼容服务（换厂商就改这三个）───
# AI_PROVIDER=openai
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
#
# 例：通义 / Kimi / 智谱 / 硅基流动等，填它们的兼容 base_url 即可
# AI_BASE_URL=https://api.moonshot.cn/v1
# AI_MODEL=moonshot-v1-32k

# ─── Anthropic ───
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-sonnet-4-5

# ─── 本地 Ollama（不用 key）───
# AI_PROVIDER=ollama
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_MODEL=qwen2.5:14b

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
